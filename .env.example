# Public API base URL. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8080

# 32+ random bytes, base64url encoded. Shared only with the auth/session service.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional: used for canonical metadata/deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Subscription Mode: set to 'true' for 1-click free trial mode, or 'false' for paid payment gateway mode
NEXT_PUBLIC_ENABLE_FREE_TRIAL=true

# Auth Mode: set to 'EMAIL' for Gmail/Email OTP verification, or 'PHONE' for Mobile SMS OTP
NEXT_PUBLIC_AUTH_METHOD=EMAIL
